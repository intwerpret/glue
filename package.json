{
  "name": "glue",
  "version": "0.5.0-rc.1",
  "private": true,
  "description": "Readable, versioned handoffs with selected evidence for work with AI.",
  "keywords": ["mcp", "ai", "context", "handoff", "evidence", "codex", "claude"],
  "repository": { "type": "git", "url": "git+https://github.com/intwerpret/glue.git" },
  "bugs": { "url": "https://github.com/intwerpret/glue/issues" },
  "homepage": "https://github.com/intwerpret/glue#readme",
  "author": "intwerpret",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["install.mjs", "src", "scripts", "integration", "docs", "tests", "tsconfig.json", "NOTICE", "TRADEMARKS.md", "THIRD-PARTY-NOTICES.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/handoff*.test.mjs",
    "format": "prettier --write src scripts integration tests install.mjs",
    "format:check": "prettier --check src scripts integration tests install.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
